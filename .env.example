# ============================================================
# Credenciales del agente — copiar como .env y completar
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Databricks (nuevo workspace dinamicasfamiliares) ---
# Databricks UI → SQL Warehouses → Starter Warehouse → Connection details
DATABRICKS_HOST=adb-XXXXXXXXXXXXXXXX.XX.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/XXXXXXXXXXXX
# Databricks UI → User Settings → Developer → Access tokens
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=workspace
